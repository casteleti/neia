FROM node:22-bookworm-slim AS builder
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/* && corepack enable
WORKDIR /workspace
COPY . .
ENV DATABASE_URL=postgresql://neia:build-only@localhost:5432/neia?schema=public
RUN pnpm install --frozen-lockfile
RUN pnpm build
RUN pnpm --filter @neia/api exec tsc --noEmit false --outDir dist --rootDir src
RUN chown -R node:node /workspace

FROM node:22-bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY --from=builder --chown=node:node /workspace /workspace
ENV NODE_ENV=production
ENV API_PORT=3001
EXPOSE 3001
HEALTHCHECK --interval=15s --timeout=5s --start-period=45s --retries=5 CMD node -e "fetch('http://127.0.0.1:3001/health/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
USER node
CMD ["node", "apps/api/dist/server.js"]
